-- Creamos la base de datos y nos posicionamos en ella
CREATE DATABASE Ventas_Tech_DB;
GO
USE Ventas_Tech_DB;
GO

-- ---------- SECCIÓN DDL ----------

-- Eliminamos las tablas si ya existen.
-- El orden es inverso al de creación: primero borramos las tablas "hija"
-- (las que tienen FK) y después las "padre", para no violar las restricciones.
DROP TABLE IF EXISTS ventas;
DROP TABLE IF EXISTS productos;
DROP TABLE IF EXISTS clientes;
DROP TABLE IF EXISTS categorias;

-- Tabla categorias: agrupa los productos por rubro (Computación, Audio, etc.)
-- Es una tabla "padre" a la que después productos va a hacer referencia.
CREATE TABLE categorias (
    id_categoria INT IDENTITY(1,1) NOT NULL PRIMARY KEY, -- PK autoincremental
    nombre_categoria VARCHAR(50) NOT NULL,               -- NOT NULL porque toda categoría debe tener nombre
    descripcion VARCHAR(200)                             -- Descripción opcional
);

-- Tabla clientes: guarda los datos de quienes compran en la tienda.
-- Es una tabla independiente que después ventas va a referenciar.
CREATE TABLE clientes (
    id_cliente INT IDENTITY(1,1) NOT NULL PRIMARY KEY,   -- PK autoincremental
    nombre VARCHAR(100) NOT NULL,                        -- Nombre obligatorio
    email VARCHAR(100) UNIQUE,                           -- UNIQUE: no puede haber dos clientes con el mismo mail
    ciudad VARCHAR(50),                                  -- Ciudad opcional
    fecha_registro DATE NOT NULL                         -- Obligatoria: siempre sabemos cuándo se registró
);

-- Tabla productos: catálogo de artículos que vende la tienda.
-- Tiene FK a categorias (cada producto pertenece a una categoría).
CREATE TABLE productos (
    id_producto INT IDENTITY(1,1) PRIMARY KEY,           -- PK autoincremental
    nombre_producto VARCHAR(100) NOT NULL,               -- Nombre obligatorio
    id_categoria INT FOREIGN KEY REFERENCES categorias(id_categoria), -- FK hacia categorias
    precio DECIMAL(10,2) NOT NULL,                       -- DECIMAL para plata (nunca FLOAT)
    stock INT DEFAULT 0,                                 -- Si no se especifica, arranca en 0
    activo TINYINT DEFAULT 1                             -- Por defecto el producto nace activo (1)
);

-- Tabla ventas: registra cada operación de venta.
-- Tiene dos FKs: una a clientes (quién compró) y otra a productos (qué compró).
CREATE TABLE ventas (
    id_venta INT IDENTITY(1,1) PRIMARY KEY,              -- PK autoincremental
    id_cliente INT FOREIGN KEY REFERENCES clientes(id_cliente),   -- FK a clientes
    id_producto INT FOREIGN KEY REFERENCES productos(id_producto), -- FK a productos
    cantidad INT NOT NULL,                               -- Cantidad de unidades vendidas
    precio_unitario DECIMAL(10,2) NOT NULL,              -- Precio al momento de la venta (puede diferir del precio actual)
    fecha_venta DATE NOT NULL                            -- Fecha de la operación
);

